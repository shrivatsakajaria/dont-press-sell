// Cloudflare deploy settings: upload the built site in dist/ as static files (no server code).
// Used by Cloudflare's Workers builds (`npx wrangler deploy`); the name must match the project in the dashboard.
// Both addresses are Custom Domains of this Worker (Cloudflare creates their DNS records and certificates).
{
  "name": "dont-press-sell",
  "compatibility_date": "2025-06-01",
  // Only dontpresssell.com: no *.workers.dev address and no preview addresses (they carry the account name).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "dontpresssell.com", "custom_domain": true },
    { "pattern": "www.dontpresssell.com", "custom_domain": true }
  ]
}
